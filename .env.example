# ==============================================================================
# ThingsBoard Super API Gateway - Plantilla de Variables de Entorno (.env.example)
# Copie este archivo como '.env' y proporcione los valores específicos para su entorno.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración General de la Aplicación
# ------------------------------------------------------------------------------
PROJECT_NAME="ThingsBoard Super API Gateway"
DEBUG=false

# ------------------------------------------------------------------------------
# 2. Base de Datos MongoDB
# ------------------------------------------------------------------------------
# URI de conexión a la instancia de MongoDB (Standalone, Replica Set o Atlas)
MONGO_URI="mongodb://localhost:27017"
MONGO_DB_NAME="tb_super_api"

# ------------------------------------------------------------------------------
# 3. Redis Broker & Estado Distribuido
# ------------------------------------------------------------------------------
# URL del servidor Redis para caché, lista negra JWT, checkpoints y broker Celery
REDIS_URL="redis://localhost:6379/0"

# ------------------------------------------------------------------------------
# 4. Parámetros de Seguridad JWT y Criptografía
# ------------------------------------------------------------------------------
# Clave secreta criptográfica para firma de JWT (mínimo 32 caracteres / 256 bits)
SECRET_KEY="tu_jwt_secret_key_super_segura_aqui_generar_con_openssl"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Clave de cifrado adicional para datos sensibles en reposo (ej. 32 bytes hex)
ENCRYPTION_KEY="tu_clave_de_cifrado_hex_32_bytes_aqui"

# ------------------------------------------------------------------------------
# 5. Bootstrapping y Superadministrador Inicial
# ------------------------------------------------------------------------------
# Credenciales para el superadministrador inicial creado en el primer arranque
FIRST_SUPERUSER_USERNAME="superadmin"
FIRST_SUPERUSER_EMAIL="superadmin@thingsboard-gateway.local"
FIRST_SUPERUSER_PASSWORD="SuperAdminSecret2026!#"

# ------------------------------------------------------------------------------
# 6. Configuración de PyCasbin (IAM / RBAC con Dominios)
# ------------------------------------------------------------------------------
CASBIN_MODEL_PATH="core/rbac_with_domains_model.conf"
CASBIN_COLLECTION_NAME="casbin_rule"
